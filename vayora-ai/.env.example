# ============================================================
#  VAYORA AI - API keys. Copy this file to ".env" and paste your keys.
#  Every key is OPTIONAL: the app still runs without them
#  (free OpenStreetMap + Open-Meteo fallbacks), but each key unlocks more.
# ============================================================

# --- Google Maps Platform (https://console.cloud.google.com/google/maps-apis) ---
# Server key: used by the backend for Routes API, Places API (New) and Geocoding API.
GOOGLE_MAPS_API_KEY=PASTE_YOUR_GOOGLE_MAPS_SERVER_KEY_HERE
# Browser key: used by the map in the browser (Maps JavaScript API).
# Restrict it to your website address. Leave empty to reuse the server key.
GOOGLE_MAPS_JS_KEY=

# --- TinyFish (https://agent.tinyfish.ai/api-keys) - powers Live Safety Intel ---
TINYFISH_API_KEY=PASTE_YOUR_TINYFISH_API_KEY_HERE

# --- Optional extras ---
# Anthropic (Claude) writes the plain-language route explanation and SOS summary.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Twilio sends real SOS text messages to trusted contacts.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Used in the User-Agent for free OpenStreetMap services (required by their policy).
CONTACT_EMAIL=you@example.com
# Where the SQLite database file is stored.
DB_PATH=vayora.db
